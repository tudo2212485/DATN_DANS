# Database Configuration (Replace with strong local/production credentials)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/agroforecast_db
DATABASE_URL_ASYNC=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/agroforecast_db

# API & Security Settings (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
API_V1_STR=/api/v1
PROJECT_NAME="AgroForecast - Hệ thống Dự báo Giá Nông sản"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated frontend origins allowed by CORS (e.g. Vercel + local dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email / Alert Notification (SMTP Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=AgroForecast <no-reply@agroforecast.vn>
