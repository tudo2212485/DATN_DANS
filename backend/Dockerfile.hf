FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/user \
    PATH="/home/user/.local/bin:${PATH}"

# System libraries required by psycopg2, Prophet/CmdStan, XGBoost/PyTorch (OpenMP), and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgomp1 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Hugging Face Spaces requires non-root UID 1000
RUN useradd -m -u 1000 -s /bin/bash user

WORKDIR /app

COPY requirements.txt .

# Install CPU-only PyTorch first to keep the image lean, then install the remaining dependencies
RUN pip install --upgrade pip \
    && pip install --no-cache-dir "torch>=2.2.0" --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt

COPY --chown=1000:1000 app ./app
COPY --chown=1000:1000 ml_pipeline ./ml_pipeline
COPY --chown=1000:1000 scripts ./scripts

# Ensure UID 1000 has write permission to ml_pipeline/saved_models and user cache directories
RUN mkdir -p /app/ml_pipeline/saved_models /home/user/.cache \
    && chown -R 1000:1000 /app /home/user

USER user

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:7860/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]

